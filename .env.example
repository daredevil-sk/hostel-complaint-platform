# Environment Variables for Team R — Hostel Grievance Platform
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ─── Database ───────────────────────────────────────────────────────────────
# Default: SQLite (works with no additional setup)
DATABASE_URL=sqlite:///./hostel_complaints.db

# PostgreSQL / Supabase example (uncomment and fill in to use):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ─── Supabase (optional — for cloud storage & PostgreSQL) ───────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=complaint-attachments

# ─── Application ────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-this-to-a-long-random-string-in-production
APP_ENV=development          # development | production
UPLOAD_DIR=uploads           # Local uploads directory (used when Supabase Storage is not configured)
MAX_UPLOAD_SIZE_MB=5

# ─── Email Notifications (optional) ─────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFY_FROM=noreply@teamr.iitpatna.ac.in

# ─── Demo mode ───────────────────────────────────────────────────────────────
DEMO_MODE=true               # Enables demo banner; set false in production
